{
  "name": "legallens-ai",
  "version": "1.0.0",
  "private": true,
  "description": "LegalLens AI — AI-powered legal document assistant",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "start": "node scripts/start-service.js",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"**/*.{ts,tsx}\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "scan:secrets": "ts-node scripts/scan-secrets.ts",
    "check:runtime-env": "ts-node scripts/check-runtime-env.ts",
    "migrate": "ts-node db/migrate.ts",
    "start:api": "npm run start --workspace=@legallens/api",
    "start:web": "npm run start --workspace=@legallens/web",
    "dev:api": "npm run dev --workspace=@legallens/api",
    "dev:web": "npm run dev --workspace=@legallens/web",
    "smoke:real-ai": "ts-node scripts/smoke-real-ai.ts"
  },
  "devDependencies": {
    "@axe-core/react": "^4.9.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.10.2",
    "cors": "^2.8.5",
    "eslint": "^8.57.0",
    "express": "^5.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "express": {
      "qs": "6.16.0"
    }
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
